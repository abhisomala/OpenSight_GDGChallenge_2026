# ---- Gemini / Vertex AI ----
# Route Gemini calls through Vertex AI (true) or the Gemini Developer API (unset/false)
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
# Only needed when GOOGLE_GENAI_USE_VERTEXAI is false (Developer API path)
GEMINI_API_KEY=your_gemini_api_key_here
# Used by the Vertex AI path; set these to your own Google Cloud project and region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ---- Web & academic search ----
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_google_search_cx_here
SERPAPI_KEY=your_serpapi_key_here

# ---- Speech ----
# Speech-to-text (desktop). Text-to-speech uses Google Cloud TTS via the credentials file below.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---- Google Cloud credentials ----
# Path to your service-account / OAuth credentials JSON, used for Vertex AI (ADC),
# Google Cloud Text-to-Speech, and Calendar OAuth. Keep this file out of git.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ---- Runtime ----
WAKE_WORD_ENABLED=true
# Backend WebSocket endpoint the desktop client connects to (deployed Cloud Run backend).
# For local development, run `uvicorn server:app --port 8080` and use the localhost line:
#OPENSIGHT_WS_URL=ws://127.0.0.1:8080/ws
OPENSIGHT_WS_URL=wss://opensight-backend-348346331222.us-east1.run.app/ws
# Set to true to enforce Firebase Anonymous Auth on /ws; leave unset for demo (default off)
REQUIRE_AUTH=